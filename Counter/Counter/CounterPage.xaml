<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.CounterPage"
             Title="CounterPage">
    <VerticalStackLayout Spacing="10">
        <Button
            Text="Dodaj nowy"
            Clicked="NewCounterButtonClicked"
            MaximumWidthRequest="150"/>
        <Editor
            x:Name="CounterNameInput"
            Placeholder="{Binding EditorPlaceholderText}"
            MaximumWidthRequest="150"/>
        <CollectionView x:Name="CounterCollection"
                    ItemsSource="{Binding Counters}"
                    Margin="20"
                    SelectionMode="Single">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                   ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout>
                        <Label 
                            Text="{Binding CounterName}"
                            HorizontalOptions="Start"/>
                        <Label
                            Text="{Binding CounterValue}"
                            HorizontalOptions="Start"
                            x:Name="CounterValueLabel"/>
                        <Button
                            Text="+"
                            Clicked="IncreaseCounterButtonClicked"
                            MaximumWidthRequest="120"
                            HorizontalOptions="Start"/>
                        <Button
                            Text="-"
                            Clicked="DecreaseCounterButtonClicked"
                            MaximumWidthRequest="120"
                            HorizontalOptions="Start"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>